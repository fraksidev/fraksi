{
  "name": "fraksi-webcam-duet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names room,stage \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 0.0.0.0 --port 5191",
    "dev:server": "tsx watch src/server/main.ts",
    "start:server": "tsx src/server/main.ts",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:room": "node scripts/three-session-smoke.mjs",
    "preview": "vite preview --port 5192"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
